<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --sidebar-width: 250px;
        }
        body.admin { background: #f6f7fb; }
        .admin-shell { min-height: 100vh; display: flex; }
        .admin-sidebar {
            width: var(--sidebar-width);
            background: #1f2937;
            color: #fff;
            padding: 1rem;
        }
        .admin-sidebar a { color: #cbd5e1; text-decoration: none; display: block; padding: .5rem .75rem; border-radius: .5rem; }
        .admin-sidebar a:hover, .admin-sidebar a.active { background: #334155; color: #fff; }
        .admin-main { flex: 1; padding: 1rem; }
        .kpi-card { border: 0; border-radius: 1rem; }
        .dark-mode body.admin, body.admin.dark { background: #0f172a; color: #e2e8f0; }
        body.admin.dark .card { background: #1e293b; color: #e2e8f0; }
        body.admin.dark .table { color: #e2e8f0; }
        @@media (max-width: 992px) {
            .admin-shell { display: block; }
            .admin-sidebar { width: 100%; }
        }
    </style>
</head>
<body class="admin">
<div class="admin-shell">
    <aside class="admin-sidebar">
        <h5 class="mb-3">Cafe Admin</h5>
        <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
        <a asp-controller="Products" asp-action="Index">San pham</a>
        <a asp-controller="Admin" asp-action="DailySalesReport">Bao cao ngay</a>
        <a asp-controller="Admin" asp-action="Accounts">Tai khoan nhan vien</a>
        <a asp-controller="Sales" asp-action="Index">Ban hang</a>
        <a asp-controller="Reports" asp-action="Revenue">Bao cao doanh thu</a>
        <a asp-controller="Hr" asp-action="Attendance">Cham cong</a>
        <a asp-controller="Hr" asp-action="Payroll">Bang luong</a>
        <button id="darkModeToggle" class="btn btn-sm btn-outline-light mt-3">Dark mode</button>
    </aside>
    <main class="admin-main">
        @RenderBody()
    </main>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
(() => {
    const key = 'admin-dark-mode';
    const enabled = localStorage.getItem(key) === '1';
    if (enabled) document.body.classList.add('dark');
    document.getElementById('darkModeToggle')?.addEventListener('click', () => {
        document.body.classList.toggle('dark');
        localStorage.setItem(key, document.body.classList.contains('dark') ? '1' : '0');
    });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
