@model CafeManagement.Models.ViewModels.DinhluongEditViewModel

@{
    ViewData["Title"] = "Tạo Công thức mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-plus-circle"></i> Tạo Công thức mới
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="IdSP" class="form-label">
                                <strong>Sản phẩm <span class="text-danger">*</span></strong>
                            </label>
                            <select asp-for="IdSP" asp-items="Model.SanphamOptions" 
                                    class="form-control" required>
                                <option value="">-- Chọn sản phẩm --</option>
                            </select>
                            <span asp-validation-for="IdSP" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">Chọn sản phẩm cần định lượng</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdThanhPhan" class="form-label">
                                <strong>Thành phần (Nguyên liệu) <span class="text-danger">*</span></strong>
                            </label>
                            <select asp-for="IdThanhPhan" asp-items="Model.ThanhphanOptions" 
                                    class="form-control" required>
                                <option value="">-- Chọn nguyên liệu --</option>
                            </select>
                            <span asp-validation-for="IdThanhPhan" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">Chọn nguyên liệu tạo thành sản phẩm</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="SoLuong" class="form-label">
                                        <strong>Số lượng <span class="text-danger">*</span></strong>
                                    </label>
                                    <input asp-for="SoLuong" type="number" step="0.01" min="0" 
                                           class="form-control" required placeholder="0.00">
                                    <span asp-validation-for="SoLuong" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="DonVi" class="form-label">
                                        <strong>Đơn vị <span class="text-danger">*</span></strong>
                                    </label>
                                    <select asp-for="DonVi" class="form-control" required>
                                        <option value="">-- Chọn đơn vị --</option>
                                        <option value="g">Gram (g)</option>
                                        <option value="ml">Mililit (ml)</option>
                                        <option value="cái">Cái</option>
                                        <option value="phần">Phần</option>
                                        <option value="gói">Gói</option>
                                        <option value="lít">Lít</option>
                                        <option value="kg">Kilogram (kg)</option>
                                    </select>
                                    <span asp-validation-for="DonVi" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                            <textarea asp-for="GhiChu" class="form-control" rows="3" placeholder="Ghi chú thêm về công thức..."></textarea>
                            <span asp-validation-for="GhiChu" class="text-danger small"></span>
                        </div>

                        <div class="text-end">
                            <a asp-action="Index" class="btn btn-secondary me-2">
                                <i class="fas fa-times"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Tạo Công thức
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="alert alert-info mt-4">
                <h6 class="mb-2"><i class="fas fa-lightbulb"></i> Hướng dẫn:</h6>
                <ul class="mb-0">
                    <li>Chọn <strong>Sản phẩm</strong> là mặt hàng bán trong quán (Cà phê, Trà sữa, v.v.)</li>
                    <li>Chọn <strong>Thành phần</strong> là nguyên liệu đi vào (Cà phê bột, Sữa đặc, v.v.)</li>
                    <li>Nhập <strong>Số lượng</strong> và <strong>Đơn vị</strong> tương ứng</li>
                    <li>Ví dụ: Cà phê sữa cần 20g cà phê bột + 30ml sữa đặc</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid #dee2e6;
    }

    .card-header {
        font-weight: 600;
    }

    .text-danger {
        color: #dc3545;
    }
</style>
