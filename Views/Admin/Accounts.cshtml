@model CafeManagement.Models.ViewModels.AdminAccountsPageViewModel
@{
    ViewData["Title"] = "Tài khoản nhân viên";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">Tài khoản nhân viên</h3>
        <div class="text-muted">Chỉ quản lý 2 vai trò: Kế toán và Thu ngân</div>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary">Quay lại dashboard</a>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-light fw-semibold">Tạo tài khoản mới</div>
            <div class="card-body">
                <form asp-action="CreateAccount" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CreateAccount.EmployeeName" class="form-label">Tên nhân viên</label>
                        <input asp-for="CreateAccount.EmployeeName" class="form-control" />
                        <span asp-validation-for="CreateAccount.EmployeeName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CreateAccount.Email" class="form-label">Email</label>
                        <input asp-for="CreateAccount.Email" class="form-control" />
                        <span asp-validation-for="CreateAccount.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CreateAccount.Role" class="form-label">Chức vụ</label>
                        <select asp-for="CreateAccount.Role" class="form-select">
                            <option value="Kế toán">Kế toán</option>
                            <option value="Thu ngân">Thu ngân</option>
                        </select>
                        <span asp-validation-for="CreateAccount.Role" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CreateAccount.Password" class="form-label">Mật khẩu</label>
                        <input asp-for="CreateAccount.Password" class="form-control" />
                        <span asp-validation-for="CreateAccount.Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CreateAccount.ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                        <input asp-for="CreateAccount.ConfirmPassword" class="form-control" />
                        <span asp-validation-for="CreateAccount.ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Tạo account</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-light fw-semibold">Danh sách tài khoản</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nhân viên</th>
                            <th>Email</th>
                            <th>Chức vụ</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Accounts)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(item.EmployeeName) ? item.EmployeeName : "Chưa gắn tên")</div>
                                </td>
                                <td>@item.Email</td>
                                <td>@item.Role</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngưng</span>
                                    }
                                </td>
                                <td>@item.CreatedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="ChangePassword" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Đổi mật khẩu</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
