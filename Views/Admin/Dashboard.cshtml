@model CafeManagement.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Admin Dashboard</h3>
    <small class="text-muted">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-2"><div class="card kpi-card shadow-sm"><div class="card-body"><small>Doanh thu hom nay</small><h6>@Model.RevenueToday.ToString("N0")</h6></div></div></div>
    <div class="col-6 col-xl-2"><div class="card kpi-card shadow-sm"><div class="card-body"><small>So hoa don</small><h6>@Model.InvoiceToday</h6></div></div></div>
    <div class="col-6 col-xl-3"><div class="card kpi-card shadow-sm"><div class="card-body"><small>Nhan vien dang lam</small><h6>@Model.ActiveEmployees</h6></div></div></div>
</div>

<div class="row g-3">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header">Doanh thu 30 ngay</div>
            <div class="card-body">
                <canvas id="revenueChart" height="120"></canvas>

            <div class="row g-3 mt-2">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header">Báo cáo</div>
                        <div class="card-body">
                            <a asp-action="DailySalesReport" class="btn btn-outline-primary">
                                <i class="bi bi-bar-chart"></i> Doanh số hàng ngày
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const revenueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueSummary.DailySeries.Select(x => x.Label)));
const revenueValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueSummary.DailySeries.Select(x => x.Value)));
new Chart(document.getElementById('revenueChart'), {
    type: 'line',
    data: { labels: revenueLabels, datasets: [{ label: 'Doanh thu', data: revenueValues, borderColor: '#16a34a', backgroundColor: 'rgba(22,163,74,.2)', tension: .35, fill: true }] },
    options: { responsive: true, maintainAspectRatio: false }
});
</script>
}
