@model CafeManagement.Models.ViewModels.SalesPrintViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>In hoa don @Model.MaHD</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
        .receipt { width: 80mm; margin: 0 auto; padding: 8px; }
        .center { text-align: center; }
        .line { border-top: 1px dashed #555; margin: 6px 0; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { padding: 3px 0; }
        .right { text-align: right; }
        .small { font-size: 12px; }
        @@media print {
            .no-print { display: none; }
            body { margin: 0; }
        }
    </style>
</head>
<body>
<div class="receipt">
    <div class="center">
        <h3 style="margin:0;">CAFE MANAGEMENT</h3>
        <div class="small">Hoa don ban le</div>
    </div>

    <div class="line"></div>
    <div class="small">So HD: <strong>@Model.MaHD</strong></div>
    <div class="small">Ngay: @Model.NgayLap.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>
    <div class="small">Khach: @Model.TenKhach</div>
    <div class="small">Thu ngan: @Model.ThuNgan</div>

    <div class="line"></div>
    <table>
        <thead>
            <tr>
                <th>Mon</th>
                <th class="right">SL</th>
                <th class="right">Gia</th>
                <th class="right">Tien</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var l in Model.Lines)
        {
            <tr>
                <td>@l.TenSP</td>
                <td class="right">@l.SoLuong</td>
                <td class="right">@l.DonGia.ToString("N0")</td>
                <td class="right">@l.ThanhTien.ToString("N0")</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="line"></div>
    <table>
        <tr><td>Tam tinh</td><td class="right">@Model.ThanhTien.ToString("N0")</td></tr>
        <tr><td>Giam gia</td><td class="right">@Model.GiamGia.ToString("N0")</td></tr>
        <tr><td><strong>Tong cong</strong></td><td class="right"><strong>@Model.TongCong.ToString("N0")</strong></td></tr>
    </table>

    <div class="line"></div>
    <div class="center small">Cam on quy khach!</div>

    <div class="no-print center" style="margin-top:12px;">
        <button onclick="window.print()">In hoa don</button>
    </div>
</div>
</body>
</html>
