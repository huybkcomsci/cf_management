@model CafeManagement.DTOs.SanphamUpsertDto
@{
    ViewData["Title"] = "Them san pham";
}

<h3 class="mb-3">Them san pham</h3>

<form asp-action="Create" method="post" class="card card-body shadow-sm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="TenSP" class="form-label"></label>
            <input asp-for="TenSP" class="form-control" />
            <span asp-validation-for="TenSP" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="IdNhom" class="form-label">Nhom san pham</label>
            <select asp-for="IdNhom" class="form-select" asp-items="ViewBag.NhomOptions"></select>
            <span asp-validation-for="IdNhom" class="text-danger"></span>
        </div>
        <div class="col-md-12">
            <label asp-for="MoTa" class="form-label"></label>
            <textarea asp-for="MoTa" rows="3" class="form-control"></textarea>
            <span asp-validation-for="MoTa" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="GiaBan" class="form-label"></label>
            <input asp-for="GiaBan" class="form-control" />
            <span asp-validation-for="GiaBan" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="GiaNhap" class="form-label"></label>
            <input asp-for="GiaNhap" class="form-control" />
            <span asp-validation-for="GiaNhap" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="SoLuongTon" class="form-label"></label>
            <input asp-for="SoLuongTon" class="form-control" />
            <span asp-validation-for="SoLuongTon" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="SLTonMin" class="form-label"></label>
            <input asp-for="SLTonMin" class="form-control" />
            <span asp-validation-for="SLTonMin" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DonViTinh" class="form-label"></label>
            <input asp-for="DonViTinh" class="form-control" />
            <span asp-validation-for="DonViTinh" class="text-danger"></span>
        </div>
        <div class="col-md-6 d-flex align-items-center">
            <div class="form-check mt-4">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Luu</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Huy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
