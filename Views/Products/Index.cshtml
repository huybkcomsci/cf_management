@model List<CafeManagement.Models.ViewModels.ProductListItemViewModel>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<h3>Danh sách sản phẩm</h3>
<p><a class="btn btn-primary" asp-action="Create">Thêm sản phẩm</a></p>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Nhóm</th>
            <th>Giá bán</th>
            <th>SL Tồn</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach(var p in Model) {
    <tr>
        <td>@p.TenSP</td>
        <td>@p.TenNhom</td>
        <td class="text-end">@p.GiaBan.ToString("N0")</td>
        <td class="text-end">@p.SoLuongTon</td>
        <td>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">Sửa</a>
            <form method="post" asp-action="Delete" asp-route-id="@p.Id" style="display:inline" onsubmit="return confirm('Xóa sản phẩm?');">
                <button class="btn btn-sm btn-outline-danger">Xóa</button>
            </form>
        </td>
    </tr>
}
    </tbody>
</table>