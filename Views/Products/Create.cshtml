@model CafeManagement.Models.Entities.Sanpham
@{
    ViewData["Title"] = "Thêm sản phẩm";
}
<h3>Thêm sản phẩm</h3>
<form method="post" asp-action="Create">
    <div class="mb-3">
        <label class="form-label">Tên</label>
        <input asp-for="TenSP" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Nhóm</label>
        <select asp-for="IdNhom" class="form-select">
            @{
                var cats = ViewBag.Categories as List<CafeManagement.Models.Entities.NhomSP>;
                if (cats != null) {
                    foreach (var c in cats) {
                        <option value="@c.Id">@c.TenNhom</option>
                    }
                }
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Giá bán</label>
        <input asp-for="GiaBan" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Số lượng tồn</label>
        <input asp-for="SoLuongTon" class="form-control" />
    </div>
    <button class="btn btn-primary">Lưu</button>
    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
</form>